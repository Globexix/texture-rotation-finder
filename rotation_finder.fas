use "C" <errno.h>
use "C" <limits.h>
use "C" <pthread.h>
use "C" <stdint.h>
use "C" <stdio.h>
use "C" <stdlib.h>
use "C" <string.h>
use "C" <time.h>
use "scan.fas"

struct Options {
    pattern_path addr
    range SearchRange
    tile_size i64
    threads i32
    print_matches bool
}

struct ObservationList {
    items addr
    count usize
    capacity usize
}

struct LineBuffer {
    text addr
    capacity usize
}

struct PatternFields {
    dx i64
    dy i64
    dz i64
    rotation i64
    extra u8
}

struct Parsed {
    value i64
    end addr
}

struct Worker {
    observations addr
    observation_count usize
    range addr
    tile_size i64
    work_begin i64
    work_end i64
    fast_path bool
    stats ScanStats
    matches MatchList
    status i32
}

fn usage(program addr, status i32) void {
    stream handle[FILE] = if status == 0 { stdout } else { stderr }
    fprintf(stream, c"Usage: %s PATTERN [options]\n\n", program)
    fprintf(stream, c"Pattern lines are: dx dy dz rotation.\n")
    fprintf(stream, c"Arbitrary dy is supported.\n")
    fprintf(stream, c"Ranges are half-open and origin-Y height may contain at most 64 values.\n\n")
    fprintf(stream, c"Options:\n")
    fprintf(stream, c"  --size N          centered N x N X/Z plane\n")
    fprintf(stream, c"  --x-min N         default -5000\n")
    fprintf(stream, c"  --x-max N         default  5000\n")
    fprintf(stream, c"  --z-min N         default -5000\n")
    fprintf(stream, c"  --z-max N         default  5000\n")
    fprintf(stream, c"  --y-min N         default -60\n")
    fprintf(stream, c"  --y-max N         default 1\n")
    fprintf(stream, c"  --tile-size N     cache tile edge, default 1024, max 1024\n")
    fprintf(stream, c"  --threads N       pthread workers, default 1\n")
    fprintf(stream, c"  --quiet           do not print individual matches\n")
    fprintf(stream, c"  --help            show this help\n")
    exit(status)
}

fn parse_i64(text addr, parsed addr) bool {
    view p = parsed[Parsed]
    __errno_location()[i32] = 0
    p.value = strtoll(text, &p.end, 10)
    if __errno_location()[i32] != 0 || p.end == text || p.end[u8] != 0 {
        return false
    }
    return true
}

fn option_i32(option addr, text addr) i32 {
    parsed Parsed = {}
    if !parse_i64(text, &parsed) || parsed.value < INT32_MIN || parsed.value > INT32_MAX {
        fprintf(stderr, c"error: invalid integer for %s: %s\n", option, text)
        exit(1)
    }
    return trunc[i32](parsed.value)
}

fn option_i64(option addr, text addr) i64 {
    parsed Parsed = {}
    if !parse_i64(text, &parsed) {
        fprintf(stderr, c"error: invalid integer for %s: %s\n", option, text)
        exit(1)
    }
    return parsed.value
}

fn parse_options(argc i32, argv addr, options addr) void {
    view o = options[Options]
    if argc < 2 { usage(argv[addr, 0], 2) }
    o.pattern_path = null
    o.range.x_min = -5000
    o.range.x_max = 5000
    o.range.y_min = -60
    o.range.y_max = 1
    o.range.z_min = -5000
    o.range.z_max = 5000
    o.tile_size = 1024
    o.threads = 1
    o.print_matches = true
    size_set bool = false
    requested_size i64 = 0
    argument_count usize = zext[usize](argc)
    index usize = 1
    while index < argument_count {
        argument addr = argv[addr, index]
        index += 1
        if strcmp(argument, c"--help") == 0 { usage(argv[addr, 0], 0) }
        if strcmp(argument, c"--quiet") == 0 {
            o.print_matches = false
            continue
        }
        if strncmp(argument, c"--", 2) != 0 {
            if o.pattern_path != null {
                fprintf(stderr, c"error: only one pattern file is allowed\n")
                exit(1)
            }
            o.pattern_path = argument
            continue
        }
        if index == argument_count {
            fprintf(stderr, c"error: missing value after %s\n", argument)
            exit(1)
        }
        value addr = argv[addr, index]
        index += 1
        if strcmp(argument, c"--size") == 0 {
            requested_size = option_i64(argument, value)
            if requested_size < 1 || requested_size > INT32_MAX {
                fprintf(stderr, c"error: --size must be in [1, INT32_MAX]\n")
                exit(1)
            }
            size_set = true
        } else if strcmp(argument, c"--x-min") == 0 {
            o.range.x_min = option_i32(argument, value)
        } else if strcmp(argument, c"--x-max") == 0 {
            o.range.x_max = option_i32(argument, value)
        } else if strcmp(argument, c"--z-min") == 0 {
            o.range.z_min = option_i32(argument, value)
        } else if strcmp(argument, c"--z-max") == 0 {
            o.range.z_max = option_i32(argument, value)
        } else if strcmp(argument, c"--y-min") == 0 {
            o.range.y_min = option_i32(argument, value)
        } else if strcmp(argument, c"--y-max") == 0 {
            o.range.y_max = option_i32(argument, value)
        } else if strcmp(argument, c"--tile-size") == 0 {
            o.tile_size = option_i64(argument, value)
        } else if strcmp(argument, c"--threads") == 0 {
            threads i64 = option_i64(argument, value)
            if threads < 1 || threads > INT_MAX {
                fprintf(stderr, c"error: --threads must be in [1, INT_MAX]\n")
                exit(1)
            }
            o.threads = trunc[i32](threads)
        } else {
            fprintf(stderr, c"error: unknown option: %s\n", argument)
            exit(1)
        }
    }
    if o.pattern_path == null {
        fprintf(stderr, c"error: a pattern file is required\n")
        exit(1)
    }
    if size_set {
        minimum i64 = -(requested_size / 2)
        maximum i64 = minimum + requested_size
        o.range.x_min = trunc[i32](minimum)
        o.range.z_min = trunc[i32](minimum)
        o.range.x_max = trunc[i32](maximum)
        o.range.z_max = trunc[i32](maximum)
    }
}

fn append_observation(list addr, dx i32, dy i32, dz i32, rotation u8) void {
    view observations = list[ObservationList]
    if observations.count == observations.capacity {
        next usize = if observations.capacity == 0 { 32 } else { observations.capacity * 2 }
        replacement addr = realloc(observations.items, next * sizeof[Observation])
        if replacement == null {
            fprintf(stderr, c"error: allocation failed\n")
            exit(1)
        }
        observations.items = replacement
        observations.capacity = next
    }
    entry addr = &observations.items[Observation, observations.count]
    entry[Observation].dx = dx
    entry[Observation].dy = dy
    entry[Observation].dz = dz
    entry[Observation].rotation = rotation
    observations.count += 1
}

fn read_pattern(path addr, list addr) void {
    file handle[FILE] = fopen(path, c"r")
    if file == null {
        fprintf(stderr, c"error: cannot open pattern file: %s\n", path)
        exit(1)
    }
    line LineBuffer = {}
    line_number usize = 0
    fields PatternFields = {}
    while getline(&line.text, &line.capacity, file) >= 0 {
        line_number += 1
        comment addr = strchr(line.text, '#')
        if comment != null { comment[u8] = 0 }
        field_count i32 = sscanf(line.text, c" %lld %lld %lld %lld %c", &fields.dx, &fields.dy, &fields.dz, &fields.rotation, &fields.extra)
        if field_count == EOF { continue }
        if field_count != 4 {
            fprintf(stderr, c"error: %s:%zu: expected: dx dy dz rotation\n", path, line_number)
            exit(1)
        }
        if fields.dx < INT32_MIN || fields.dx > INT32_MAX || fields.dy < INT32_MIN || fields.dy > INT32_MAX || fields.dz < INT32_MIN || fields.dz > INT32_MAX || fields.rotation < 0 || fields.rotation > 3 {
            fprintf(stderr, c"error: %s:%zu: value is outside its supported range\n", path, line_number)
            exit(1)
        }
        append_observation(list, trunc[i32](fields.dx), trunc[i32](fields.dy), trunc[i32](fields.dz), trunc[u8](fields.rotation))
    }
    free(line.text)
    fclose(file)
}

fn validate(observations addr, observation_count usize, options addr) void {
    view o = options[Options]
    if observation_count == 0 || observation_count > 255 {
        fprintf(stderr, c"error: pattern must contain between 1 and 255 observations\n")
        exit(1)
    }
    if o.range.x_min >= o.range.x_max || o.range.y_min >= o.range.y_max || o.range.z_min >= o.range.z_max {
        fprintf(stderr, c"error: all search ranges must be non-empty\n")
        exit(1)
    }
    if sext[i64](o.range.y_max) - sext[i64](o.range.y_min) > 64 {
        fprintf(stderr, c"error: origin-Y height may contain at most 64 values\n")
        exit(1)
    }
    if o.range.x_min == INT32_MIN || o.range.z_min == INT32_MIN {
        fprintf(stderr, c"error: X/Z ranges may not contain INT32_MIN\n")
        exit(1)
    }
    if o.tile_size < 1 || o.tile_size > 1024 {
        fprintf(stderr, c"error: tile size must be in [1,1024]\n")
        exit(1)
    }
    index usize = 0
    while index < observation_count {
        observation addr = &observations[Observation, index]
        dx i64 = sext[i64](observation[Observation].dx)
        dy i64 = sext[i64](observation[Observation].dy)
        dz i64 = sext[i64](observation[Observation].dz)
        y_min i64 = sext[i64](o.range.y_min) + dy
        y_max i64 = sext[i64](o.range.y_max) - 1 + dy
        x_min i64 = sext[i64](o.range.x_min) + dx
        x_max i64 = sext[i64](o.range.x_max) - 1 + dx
        z_min i64 = sext[i64](o.range.z_min) + dz
        z_max i64 = sext[i64](o.range.z_max) - 1 + dz
        if y_min < INT32_MIN || y_max > INT32_MAX {
            fprintf(stderr, c"error: Y range plus observation offsets exceeds int32\n")
            exit(1)
        }
        if x_min < -sext[i64](INT32_MAX) || x_max > INT32_MAX || z_min < -sext[i64](INT32_MAX) || z_max > INT32_MAX {
            fprintf(stderr, c"error: range plus observation offsets exceeds int32\n")
            exit(1)
        }
        index += 1
    }
}

fn run_worker(argument addr) addr {
    view w = argument[Worker]
    if w.fast_path {
        w.status = scan_worker(w.observations, w.observation_count, w.range, w.tile_size, w.work_begin, w.work_end, &argument[Worker].matches, &argument[Worker].stats)
    } else {
        w.status = scan_general_worker(w.observations, w.observation_count, w.range, w.work_begin, w.work_end, &argument[Worker].matches, &argument[Worker].stats)
    }
    return null
}

fn compare_matches(left addr, right addr) i32 {
    view a = left[Match]
    view b = right[Match]
    if a.z != b.z { return if a.z < b.z { -1 } else { 1 } }
    if a.x != b.x { return if a.x < b.x { -1 } else { 1 } }
    if a.y != b.y { return if a.y < b.y { -1 } else { 1 } }
    return 0
}

fn main(argc i32, argv addr) i32 {
    options Options = {}
    parse_options(argc, argv, &options)
    observations ObservationList = {}
    defer { free(observations.items) }
    read_pattern(options.pattern_path, &observations)
    validate(observations.items, observations.count, &options)

    fast_path bool = options.range.y_min >= -60 && options.range.y_max <= 1
    for index usize = 0; index < observations.count; index += 1 {
        observation addr = &observations.items[Observation, index]
        if observation[Observation].dy != 0 && observation[Observation].dy != 1 {
            fast_path = false
        }
    }

    positive_z i64 = sext[i64](options.range.z_max) - 1
    negative_z i64 = -sext[i64](options.range.z_min)
    canonical_z_max i64 = maximum[i64](0, maximum[i64](positive_z, negative_z))
    canonical_z_count i64 = canonical_z_max + 1
    band_count i64 = (canonical_z_count + 63) / 64
    work_count i64 = if fast_path { band_count } else { sext[i64](options.range.x_max) - sext[i64](options.range.x_min) }
    worker_count i64 = minimum[i64](sext[i64](options.threads), work_count)

    workers addr = calloc(bitcast[usize](worker_count), sizeof[Worker])
    threads addr = calloc(bitcast[usize](worker_count), sizeof[u64])
    if workers == null || threads == null {
        fprintf(stderr, c"error: allocation failed\n")
        return 1
    }
    defer { free(threads) }
    defer { free(workers) }

    for index i64 = 0; index < worker_count; index += 1 {
        worker addr = &workers[Worker, bitcast[usize](index)]
        view w = worker[Worker]
        w.observations = observations.items
        w.observation_count = observations.count
        w.range = &options.range
        w.tile_size = options.tile_size
        w.fast_path = fast_path
        if fast_path {
            band_begin i64 = band_count * index / worker_count
            band_end i64 = band_count * (index + 1) / worker_count
            w.work_begin = band_begin * 64
            w.work_end = minimum[i64](band_end * 64, canonical_z_count)
        } else {
            w.work_begin = sext[i64](options.range.x_min) + work_count * index / worker_count
            w.work_end = sext[i64](options.range.x_min) + work_count * (index + 1) / worker_count
        }
    }

    started timespec = {}
    finished timespec = {}
    clock_gettime(CLOCK_MONOTONIC, &started)
    if worker_count == 1 {
        run_worker(&workers[Worker, 0])
    } else {
        created i64 = 0
        while created < worker_count - 1 {
            create_status i32 = pthread_create(&threads[u64, bitcast[usize](created)], null, &run_worker, &workers[Worker, bitcast[usize](created)])
            if create_status != 0 {
                fprintf(stderr, c"error: pthread_create: %s\n", strerror(create_status))
                break
            }
            created += 1
        }
        if created == worker_count - 1 {
            run_worker(&workers[Worker, bitcast[usize](worker_count - 1)])
        }
        for index i64 = 0; index < created; index += 1 {
            pthread_join(threads[u64, bitcast[usize](index)], null)
        }
        if created != worker_count - 1 { return 1 }
    }
    clock_gettime(CLOCK_MONOTONIC, &finished)

    stats ScanStats = {}
    matches MatchList = {}
    defer { free(matches.items) }
    for index i64 = 0; index < worker_count; index += 1 {
        worker addr = &workers[Worker, bitcast[usize](index)]
        if worker[Worker].status != 0 {
            fprintf(stderr, c"error: Fas worker failed with status %d\n", worker[Worker].status)
            return 1
        }
        stats.paid_source_columns += worker[Worker].stats.paid_source_columns
        stats.generated_source_blocks += worker[Worker].stats.generated_source_blocks
        stats.prefix_survivors += worker[Worker].stats.prefix_survivors
        stats.verifier_evaluations += worker[Worker].stats.verifier_evaluations
        stats.matches += worker[Worker].stats.matches
        if worker[Worker].matches.count != 0 {
            next_count usize = matches.count + worker[Worker].matches.count
            replacement addr = realloc(matches.items, next_count * sizeof[Match])
            if replacement == null {
                fprintf(stderr, c"error: allocation failed\n")
                return 1
            }
            matches.items = replacement
            memcpy(&matches.items[Match, matches.count], worker[Worker].matches.items, worker[Worker].matches.count * sizeof[Match])
            matches.count = next_count
        }
    }
    if matches.count > 1 {
        qsort(matches.items, matches.count, sizeof[Match], &compare_matches)
    }
    if options.print_matches {
        for index usize = 0; index < matches.count; index += 1 {
            entry addr = &matches.items[Match, index]
            printf(c"%d %d %d\n", entry[Match].x, entry[Match].y, entry[Match].z)
        }
    }

    width u64 = bitcast[u64](sext[i64](options.range.x_max) - sext[i64](options.range.x_min))
    depth u64 = bitcast[u64](sext[i64](options.range.z_max) - sext[i64](options.range.z_min))
    height u64 = bitcast[u64](sext[i64](options.range.y_max) - sext[i64](options.range.y_min))
    if mul_hi(width, depth) != 0 || mul_hi(width * depth, height) != 0 {
        fprintf(stderr, c"error: candidate count exceeds uint64\n")
        return 1
    }
    candidate_columns u64 = width * depth
    candidate_positions u64 = candidate_columns * height
    elapsed f64 = cvt[f64](finished.tv_sec - started.tv_sec) + cvt[f64](finished.tv_nsec - started.tv_nsec) / 1000000000.0
    rate f64 = if elapsed == 0.0 { 0.0 } else { cvt[f64](candidate_positions) / elapsed / 1000000.0 }
    fprintf(stderr, c"threads=%d\n", trunc[i32](worker_count))
    fprintf(stderr, c"threads_requested=%d\n", options.threads)
    fprintf(stderr, c"elapsed_seconds=%.3f\n", elapsed)
    fprintf(stderr, c"candidate_columns=%lu\n", candidate_columns)
    fprintf(stderr, c"candidate_positions=%lu\n", candidate_positions)
    fprintf(stderr, c"paid_source_columns=%lu\n", stats.paid_source_columns)
    fprintf(stderr, c"generated_source_blocks=%lu\n", stats.generated_source_blocks)
    fprintf(stderr, c"prefix_survivors=%lu\n", stats.prefix_survivors)
    fprintf(stderr, c"verifier_evaluations=%lu\n", stats.verifier_evaluations)
    fprintf(stderr, c"matches=%lu\n", stats.matches)
    fprintf(stderr, c"million_positions_per_second=%.3f\n", rate)
    return 0
}
